include Makefile-sources
AS=nasm
CFLAGS=-m32 -g -Wno-conditional-type-mismatch -Wall -I. -I /usr/include/i386-linux-gnu
CC=gcc

all:	Makefile-config bandwidth32

include Makefile-config

bandwidth32: Benchmark.c BenchmarkX86.c ${SRC} routines-x86-32bit.asm libOOC.a
	${AS} -f elf routines-x86-32bit.asm -o routines-x86-32bit.o
	${CC} ${CFLAGS} -c -I ./OOC Benchmark.c BenchmarkX86.c
	${CC} ${CFLAGS} ${SRC} Benchmark.o BenchmarkX86.o routines-x86-32bit.o -o bandwidth32 ${LIB}

