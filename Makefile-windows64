include Makefile-sources
AS=nasm
CFLAGS= -g -Wno-conditional-type-mismatch -Wall -I.
CC=gcc

all:	Makefile-config bandwidth64

include Makefile-config

bandwidth64: Benchmark.c BenchmarkX86.c ${SRC} routines-x86-64bit.asm libOOC.a
	${AS} -f win64 routines-x86-64bit.asm -o routines-x86-64bit.o
	${CC} -D__WIN64__ ${CFLAGS} -c -I ./OOC Benchmark.c BenchmarkX86.c
	${CC} ${CFLAGS} -D__WIN64__ -DWINVER=0x0600 -m64 ${SRC} BenchmarkX86.o Benchmark.o routines-x86-64bit.o ${LIB} -o bandwidth64 

