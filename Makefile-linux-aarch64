include Makefile-sources
ARM_AS=as -march=armv8-a
ARM_CC=gcc 
CFLAGS= -g -Wno-conditional-type-mismatch -Wall

all:	Makefile-config bandwidth64

include Makefile-config

bandwidth64: Benchmark.c BenchmarkARM.c ${SRC} routines-arm-64bit.asm libOOC.a
	${ARM_AS} routines-arm-64bit.asm -o routines-arm-64bit.o
	${ARM_CC} ${CFLAGS} -c -I ./OOC Benchmark.c BenchmarkARM.c
	${ARM_CC} routines-arm-64bit.o Benchmark.o BenchmarkARM.o ${SRC} ${CFLAGS} -o bandwidth64 ${LIB}

