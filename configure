# This program is distributed in the hope that it will be useful,
# but WITHOUT ANY WARRANTY; without even the implied warranty of
# MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
# GNU General Public License for more details.
#
# You should have received a copy of the GNU General Public License
# along with this program; if not, write to the Free Software
# Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA  02110-1301  USA
#
# The author may be reached at 3 at zs3 dot me.
#============================================================================*/

rm -f Makefile-config
touch Makefile-config

TMPFILE=./ooc.c
OK=1

is_macos=0
if [[ `uname -o` == 'Darwin' ]]; then
	is_macos=1
fi

# Mac Homebrew paths
OSXINC=/opt/homebrew/include
OSXLIB=/opt/homebrew/lib

#-------------------
# Look for Clang:
#
found_clang=0
echo "int main(){}" > $TMPFILE
if clang $TMPFILE 2> /dev/null ; then
	echo "CC=clang " >> Makefile-config
	echo Detected Clang.
	found_clang=1
else
	echo "CC=gcc " >> Makefile-config
	echo "Missing optional Clang.      (type: sudo apt install clang)"
fi
rm -f $TMPFILE

#------------------------------------
# Look for blocks i.e. closures in C:
#
if [ $found_clang -eq 1 ]; then
	if [[ `uname -o` == "Darwin" ]]; then
		# MacOS has blocks built-in.
		echo Detected Clang blocks.
	else
		echo "#include <stdio.h>" > $TMPFILE
		echo "void (^block)(void) = ^{ puts(\"Blocks work!\"); };" >> $TMPFILE
		echo "int main() { block(); }" >> $TMPFILE
		if clang $TMPFILE -fblocks -lBlocksRuntime 2> /dev/null ; then
			echo Detected Clang blocks.
			echo "CFLAGS+= -fblocks " >> Makefile-config
			echo "LIB+= -lBlocksRuntime " >> Makefile-config
			rm -f a.out a.exe
		else
			echo "Missing optional blocks.     (type: sudo apt install libblocksruntime-dev)"
		fi
	fi
fi
rm -f $TMPFILE

#-----------------
# Look for OpenGL:
#
have_gl=0
if [[ $is_macos -eq 0 ]]; then
	echo "#include <stdio.h>" > $TMPFILE
	echo "#include <GL/gl.h>" >> $TMPFILE
	echo "#include <GL/glu.h>" >> $TMPFILE
	echo "int main(){ glClear(0); return 0;}" >> $TMPFILE
	if gcc -I/usr/include -I/usr/local/include -I$OSXINC -L$OSXLIB $TMPFILE -lGL 2> /dev/null ; then
		echo Detected OpenGL and GLU.
		echo "LIB+=-lGL " >> Makefile-config
		rm -f a.out a.exe
		have_gl=1
	else
		echo "Missing optional OpenGL+GLU. (type: sudo apt install libgl-dev libglu1-mesa-dev)"
	fi
else
	echo "#include <stdio.h>" > $TMPFILE
	echo "#include <OpenGL/gl.h>" >> $TMPFILE
	echo "int main(){ glClear(0); return 0;}" >> $TMPFILE
	if gcc -I/usr/include -I/usr/local/include -framework OpenGL $TMPFILE 2> /dev/null; then
		echo "Detected Apple OpenGL framework."
		echo "LIB+=-framework OpenGL " >> Makefile-config
		rm -f a.out 
		have_gl=1
	else
		echo "Missing Apple OpenGL framework."
	fi
fi
rm -f $TMPFILE

#-------------------
# Look for GLUT:
#
if [[ $have_gl -eq 1 ]]; then
	if [[ $is_macos -eq 0 ]]; then
		echo "#include <stdio.h>" > $TMPFILE
		echo "#include <GL/gl.h>" >> $TMPFILE
		echo "#include <GL/glu.h>" >> $TMPFILE
		echo "#include <GL/glext.h>" >> $TMPFILE
		echo "#include <GL/glut.h>" >> $TMPFILE
		echo "int main(){ glClear(0); glutMainLoop(); return 0;}" >> $TMPFILE
		if gcc -I/usr/include -I/usr/local/include -I$OSXINC -L$OSXLIB $TMPFILE -lGL -lglut 2> /dev/null; then
			echo Detected FreeGLUT.
			echo "LIB+=-lglut " >> Makefile-config
			echo "#define HAVE_GLUT" >> config.h
			rm -f a.out a.exe
		else
			echo "Missing optional FreeGLUT.   (type: sudo apt install freeglut3-dev)"
		fi
	else
		echo "#include <stdio.h>" > $TMPFILE
		echo "#include <GL/gl.h>" >> $TMPFILE
		echo "#include <GL/glu.h>" >> $TMPFILE
		echo "#include <GL/glext.h>" >> $TMPFILE
		echo "#include <GLUT/glut.h>" >> $TMPFILE
		echo "int main(){ glClear(0); glutMainLoop(); return 0;}" >> $TMPFILE
		if gcc -I/usr/include -I/usr/local/include -I$OSXINC -L$OSXLIB $TMPFILE -framework GLUT -framework OpenGL 2> /dev/null; then
			echo "Detected Apple GLUT framework."
			echo "LIB+=-framework GLUT " >> Makefile-config
			echo "CFLAGS+=-I/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk/System/Library/Frameworks/GLUT.framework/Versions/A/Headers/ " >> Makefile-config
			echo "#define HAVE_GLUT" >> config.h
			rm -f a.out 
		else
			echo "Missing Apple GLUT framework."
		fi
	fi
	rm -f $TMPFILE
fi

#-------------------
# Look for jpeglib:
#
echo "#include <stdio.h>" > $TMPFILE
echo "#include <jpeglib.h>" >> $TMPFILE
echo "int main(){return 0;}" >> $TMPFILE
if gcc -I/usr/include -I/usr/local/include -I$OSXINC -L$OSXLIB $TMPFILE -ljpeg 2> /dev/null; then
	if [[ $is_macos -eq 0 ]]; then
		echo Detected jpeglib.
	else
		echo Detected jpeg-turbo.
	fi
	echo "LIB+=-ljpeg " >> Makefile-config
	rm -f a.out a.exe
else
	if [[ $is_macos -eq 0 ]]; then
		echo "Missing optional jpeglib.    (type: sudo apt install libjpeg-dev)"
	else
		echo "Missing optional jpeglib.    (type: brew install jpeg-turbo)"
	fi
fi
rm -f $TMPFILE

#-------------------
# Look for libpng:
#
echo "#include <png.h>" > $TMPFILE
echo "int main(){ printf (\"PNG version %s\n\",PNG_LIBPNG_VER_STRING);}" >> $TMPFILE
if gcc -I/usr/include -I/usr/local/include -I$OSXINC -L$OSXLIB $TMPFILE -lpng 2> /dev/null; then
	echo Detected libpng.
	if [[ $is_macos -eq 1 ]]; then
		echo "LIB+=-L$OSXLIB " >> Makefile-config
	fi
	echo "LIB+=-lpng " >> Makefile-config
	rm -f a.out a.exe
else
	if [[ $is_macos -eq 0 ]]; then
		echo "Missing optional libpng.     (type: sudo apt install libpng-dev)"
	else
		echo "Missing optional libpng.     (type: brew install libpng)"
	fi
fi
rm -f $TMPFILE

#-------------------
# Look for libtiff:
# NOTE: libtiff often depends on other libraries such as zstd and libz, so if you plan on 
# doing a static build you will need to add those to Makefile-config manually.
#
echo "#include <stdio.h>" > $TMPFILE
echo "#include <tiff.h>" >> $TMPFILE
echo "#include <tiffio.h>" >> $TMPFILE
echo "int main(){TIFF *tif = TIFFOpen(\"PIA25970.tif\", \"r\"); return 0;}" >> $TMPFILE
if gcc -I$OSXINC -L$OSXLIB $TMPFILE -ltiff 2> /dev/null; then
	echo Detected libtiff.
	if [[ $is_macos -eq 1 ]]; then
		echo "LIB+=-L$OSXLIB " >> Makefile-config
	fi
	echo "LIB+=-ltiff " >> Makefile-config
	rm -f a.out a.exe
else
	if [[ $is_macos -eq 0 ]]; then
		echo "Missing optional libtiff.    (type: sudo apt install libtiff-dev)"
	else
		echo "Missing optional libtiff.    (type: brew install libtiff)"
	fi
fi
rm -f $TMPFILE

#-------------------
# Look for libcurl:
#
echo "#include <stdio.h>" > $TMPFILE
echo "#include <curl/curl.h>" >> $TMPFILE
echo "int main(){return 0;}" >> $TMPFILE
if gcc -I/usr/include -I/usr/local/include -I$OSXINC -L$OSXLIB $TMPFILE -lcurl 2> /dev/null; then
	echo Detected libcurl.
	echo "LIB+=-lcurl " >> Makefile-config
	rm -f a.out a.exe
else
	echo "Missing optional libcurl.    (type: sudo apt install libcurl4-openssl-dev)"
fi
rm -f $TMPFILE

#-------------------
# Look for freetype2:
#
echo "#include <stdio.h>" > $TMPFILE
echo "#include <ft2build.h>" >> $TMPFILE
echo "#include FT_GLYPH_H" >> $TMPFILE
echo "#include FT_TRUETYPE_DRIVER_H" >> $TMPFILE
echo "int main(){" >> $TMPFILE
echo "FT_Bitmap *bitmap;" >> $TMPFILE
echo "FT_BitmapGlyphRec *record;" >> $TMPFILE
echo "FT_Face face;" >> $TMPFILE
echo "FT_Glyph glyph;" >> $TMPFILE
echo "}" >> $TMPFILE
if gcc -I/usr/include -I/usr/include/freetype2 -I$OSXINC/freetype2 -L$OSXLIB $TMPFILE 2> /dev/null; then
	echo Detected Freetype2.
	echo "LIB+=-lfreetype " >> Makefile-config
	rm -f a.out a.exe
	if [[ $is_macos -eq 1 ]]; then
		echo "LIB+=-L$OSXLIB " >> Makefile-config
	fi
else
	if [[ $is_macos -eq 0 ]]; then
		echo "Missing optional Freetype2.  (type: sudo apt install libfreetype-dev)"
	else
		echo "Missing optional Freetype2.  (type: brew install freetype)"
	fi
fi
rm -f $TMPFILE

#-------------------
# Compile x86 asm:
#
MACHINE=`uname -m`
if [[ "$MACHINE" == "x86_64" || "$MACHINE" == "i386" || "$MACHINE" == "i486" || "$MACHINE" == "i586" || "$MACHINE" == "i686" ]]; then
	NASM=`which nasm 2> /dev/null`
	if [[ "$NASM" == "" ]]; then
		echo "Missing required NASM.       (type: sudo apt install nasm)"
		OK=0
	else
		echo "Found required NASM."
	fi
fi

if [[ "$OK" == 1 ]]; then
	if [[ "$0" == './configure' ]]; then
		sort Makefile-config | uniq > .Makefile-config
		mv .Makefile-config Makefile-config
		echo "Ready."
	fi
fi

